# Copy to .env for local runs. Deployed environments set these in Render.

# test (local / test harness), daily, pre or prod
DEMO_SHOP_ENV=test

# In test, each process creates its own schema in this database and drops it on exit.
# Use a direct connection, not a pooled one (poolers drop the search_path option).
DATABASE_URL=postgresql://shop:shop@127.0.0.1:5432/shop

# Required outside test.
# SESSION_SECRET=
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=admin-pass

# Fault knobs: off by default, ignored in prod.
# DEMO_SHOP_LATENCY_MS=0
# DEMO_SHOP_FLAKY_RATE=0
# DEMO_SHOP_FLAKY_SEED=
# DEMO_SHOP_BUG=
